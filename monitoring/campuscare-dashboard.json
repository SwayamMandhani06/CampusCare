    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 4,
      "title": "Node CPU Usage",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "campuscare-prometheus"
      },
      "description": "Overall EC2 node CPU usage percentage (from cAdvisor)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "campuscare-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (rate(container_cpu_usage_seconds_total{id=\"/\"}[2m]) / on(instance) machine_cpu_cores)",
          "instant": true,
          "legendFormat": "CPU Usage",
          "range": false,
          "refId": "A"
        }
      ]
    },
