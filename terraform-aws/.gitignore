# Terraform local execution cache and plugins
.terraform/
.terraform.lock.hcl

# Terraform state files (contain live resource status and potentially sensitive attributes)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Local secret variables
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Execution plan files
*.tfplan

# Crash log files
crash.log
crash.*.log

# CLI configuration and override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Whitelist explicitly to ensure required configuration files are never ignored
!*.tf
!outputs.tf
!variables.tf
!providers.tf
!main.tf
