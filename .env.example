# MongoDB Root Credentials (Containerized Database)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=campuscare_secure_password_2026

# Backend API Configuration
PORT=5000
JWT_SECRET=campuscare_super_secret_jwt_key_2026_devops_fa1

# Frontend API Target (Vite Build Argument)
# Note: For local development, use http://localhost:5000.
# For cloud/VM deployments (AWS EC2, GCP Compute, DigitalOcean), rebuild with the public IP/domain (e.g. http://<PUBLIC_IP>:5000).
VITE_API_URL=http://localhost:5000
