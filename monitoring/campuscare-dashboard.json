      },
      "id": 1,
      "title": "Backend Availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "campuscare-prometheus"
      },
      "description": "Current availability status of CampusCare backend service target",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "campuscare-prometheus"
          },
          "editorMode": "code",
          "expr": "up{job=\"campuscare-backend\"}",
          "instant": true,
          "legendFormat": "Backend Target",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "title": "Backend Pod Availability",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "campuscare-prometheus"
      },
      "description": "Number of active backend pods serving requests in campuscare namespace",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "campuscare-prometheus"
          },
          "editorMode": "code",
          "expr": "count(count by (pod) (container_memory_working_set_bytes{namespace=\"campuscare\", container=\"backend\"}))",
          "instant": true,
          "legendFormat": "Active Pods",
          "range": false,
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
