# ==============================================================================
# CampusCare Environment Variables Template
# Copy this file to .env and adjust values as needed for your environment:
# cp .env.example .env
# ==============================================================================

# MongoDB Root Credentials (Containerized Database)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=campuscare_secure_password_2026

# Backend API Configuration
PORT=5000
JWT_SECRET=campuscare_super_secret_jwt_key_2026_devops_fa1

# Frontend API Target (Vite Build Argument)
# Note: For local development, use http://localhost:5000.
# For cloud/VM deployments (AWS EC2, GCP Compute, DigitalOcean), rebuild with the public IP/domain (e.g. http://<PUBLIC_IP>:5000).
VITE_API_URL=http://localhost:5000

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_IMAGE_SIZE_MB=5

# Email Notification Configuration (Optional - Disabled by default)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CampusCare Notifications" <no-reply@campuscare.local>
