# Server Port
PORT=5000

# MongoDB Database Connection String
# For local MongoDB instance:
MONGO_URI=mongodb://127.0.0.1:27017/campuscare
# For MongoDB Atlas cloud connection:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/campuscare?retryWrites=true&w=majority

# JSON Web Token Secret Key
JWT_SECRET=campuscare_super_secret_jwt_key_2026_devops_fa1

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_IMAGE_SIZE_MB=5

# Email Notification Configuration (Optional - Disabled by default)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CampusCare Notifications" <no-reply@campuscare.local>

# Seed / Demo Account Credentials Configuration
# Deterministic password for all seeded accounts (Admin, Staff, Student)
# Fallback in development is: CampusCare@2026
SEED_DEMO_PASSWORD=CampusCare@2026

# Batch 2: Intelligent Priority Automation & SLA Scheduler
SLA_SCHEDULER_ENABLED=true
SLA_CHECK_INTERVAL_MS=60000
SLA_LEASE_TTL_MS=45000
FIRST_ESCALATION_AFTER_BREACH_MINUTES=0
SECOND_ESCALATION_AFTER_BREACH_MINUTES=120

# Batch 3: AI-Assisted Classification & Duplicate Detection
AI_CLASSIFICATION_ENABLED=false
AI_PROVIDER=mock
# Optional API key if using cloud provider (e.g. groq, gemini):
# AI_API_KEY=
DUPLICATE_SIMILARITY_THRESHOLD=0.65
DUPLICATE_LOOKBACK_DAYS=30